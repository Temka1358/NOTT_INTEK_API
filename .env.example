# --- MySQL (today's nott_maindb) ---
MYSQL_HOST=192.168.10.X
MYSQL_PORT=3306
MYSQL_USER=nott_intek_api
MYSQL_PASSWORD=
MYSQL_DATABASE=nott_maindb
# Confirmed 2026-10-23: config.ini.php does mysqli_set_charset($con, 'utf8').
MYSQL_CHARSET=utf8
MYSQL_POOL_SIZE=10

# MUST match PHP-FPM date.timezone on cms1 (verify-legacy-2.sh section D).
# PHP CLI on cms1 reports Asia/Shanghai (+08, same clock as Ulaanbaatar).
PHP_TIMEZONE=Asia/Shanghai

# What /var/config.ini.php prints when included, as a JSON string. Every
# response body starts with it. cms1: "\n" (confirmed 2026-10-23 from the
# live bytes of all five endpoints).
# CONFIG_INCLUDE_OUTPUT=\n        (default; set to "" only if config.ini.php changes)

# --- upstreams (defaults are the legacy hardcoded values) ---
CAS_REGISTER_TOKEN_URL=http://192.168.10.122/nvod/cmsRegisterToken
XVOD_ORDER_URL=https://xvod.ddishtv.mn/nvod/ordernOTT
XVOD_DOWNLOADED_URL=https://xvod.ddishtv.mn/nvod/movieDownloaded
XVOD_CLIENT_PROVIDER_NAME=ARION Technology
# The value hardcoded in cdn.php's billing body. Kept out of source now.
XVOD_CLIENT_PROVIDER_PASSWORD=
UPSTREAM_TIMEOUT_MS=10000

# --- legacy file logs ---
LEGACY_LOGS=true
LEGACY_LOG_DIR=/var/www/cms/log
LEGACY_LOG_MAX_LINES=10000

# URL directory of the scripts: https://cms.ddishtv.mn/nott/<script>.php
ROUTE_PREFIX=/nott
# CDN -> CMS callback, served on the LAN-only port 80 vhost: http://<cms>/cms_cdn.php
CDN_CALLBACK_PATH=/cms_cdn.php
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8090
TRUST_X_REAL_IP=true
